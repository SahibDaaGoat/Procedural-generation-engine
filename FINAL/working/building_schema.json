{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/map-generation/building-schema.json",
  "title": "Generated Multi-Floor Game Map",
  "type": "object",
  "required": ["schema_version", "metadata", "coordinate_system", "floors", "stairs"],
  "properties": {
    "schema_version": { "const": 2 },
    "metadata": {
      "type": "object",
        "required": ["seed", "floor_count", "rooms_per_floor", "total_room_count", "map_width", "map_height", "floor_height"],
      "properties": {
        "seed": { "type": "integer" },
        "floor_count": { "type": "integer", "minimum": 1 },
        "rooms_per_floor": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "total_room_count": { "type": "integer", "minimum": 1 },
        "map_width": { "type": "number", "exclusiveMinimum": 0 },
        "map_height": { "type": "number", "exclusiveMinimum": 0 },
        "floor_height": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "coordinate_system": {
      "type": "object",
      "required": ["origin", "units", "bounds"],
      "properties": {
        "origin": { "const": "bottom_left" },
        "units": { "const": "map_units" },
        "bounds": { "$ref": "#/$defs/rectangle" }
      },
      "additionalProperties": false
    },
    "floors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "seed", "room_count", "rooms", "navigation"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "seed": { "type": "integer" },
          "room_count": { "type": "integer", "minimum": 1 },
          "rooms": {
            "type": "array",
            "items": { "$ref": "#/$defs/room" }
          },
          "navigation": {
            "type": "object",
            "required": ["start_room", "target_room", "dfs_path", "shortest_path"],
            "properties": {
              "start_room": { "type": "integer", "minimum": 1 },
              "target_room": { "type": "integer", "minimum": 1 },
              "dfs_path": { "$ref": "#/$defs/path" },
              "shortest_path": { "$ref": "#/$defs/path" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "stairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "connects_floors", "from", "to", "flight"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "type": { "const": "stairs" },
          "connects_floors": {
            "type": "array",
            "prefixItems": [
              { "type": "integer", "minimum": 1 },
              { "type": "integer", "minimum": 2 }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "from": { "$ref": "#/$defs/stairEndpoint" },
          "to": { "$ref": "#/$defs/stairEndpoint" },
          "flight": {
            "type": "object",
            "required": ["start", "end", "horizontal_run", "vertical_rise", "clear_width"],
            "properties": {
              "start": { "$ref": "#/$defs/point3" },
              "end": { "$ref": "#/$defs/point3" },
              "horizontal_run": { "type": "number", "minimum": 0 },
              "vertical_rise": { "type": "number", "exclusiveMinimum": 0 },
              "clear_width": { "type": "number", "exclusiveMinimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "rectangle": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "room": {
      "type": "object",
      "required": ["id", "region", "bounds", "center", "connections", "stairs"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "region": { "$ref": "#/$defs/rectangle" },
        "bounds": { "$ref": "#/$defs/rectangle" },
        "center": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          },
          "additionalProperties": false
        },
        "connections": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true
        },
        "stairs": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "path": {
      "oneOf": [
        { "type": "null" },
        { "type": "array", "items": { "type": "integer", "minimum": 1 } }
      ]
    },
    "stairEndpoint": {
      "type": "object",
      "required": ["floor", "room", "side", "position", "width"],
      "properties": {
        "floor": { "type": "integer", "minimum": 1 },
        "room": { "type": "integer", "minimum": 1 },
        "side": { "enum": ["north", "south", "east", "west"] },
        "position": {
          "type": "object",
          "required": ["x", "y"],
          "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
          "additionalProperties": false
        },
        "width": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "point3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
